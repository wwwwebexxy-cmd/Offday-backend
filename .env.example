# Copy this file to .env and replace the placeholders locally or on the server.
# Never commit .env or paste SMTP credentials into source control.

DEBUG=False
SECRET_KEY=replace-with-a-new-secret
ALLOWED_HOSTS=your-api-domain.example

DB_NAME=replace-with-new-database-name
DB_USER=replace-with-new-database-user
DB_PASSWORD=replace-with-new-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

SITE_URL=https://your-storefront-domain.example
STOREFRONT_ORIGINS=https://your-storefront-domain.example

# Customer email and invoice branding.
BRAND_NAME=Lifeline Medical Supplies
BRAND_SHORT_NAME=Lifeline
BRAND_SUPPORT_EMAIL=lifeandline@gmail.com
BRAND_PHONE=+971 56 263 7379
BRAND_COUNTRY=United Arab Emirates
BRAND_TAGLINE=Medical Supplies
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_CITY=
INVOICE_SELLER_VAT_NUMBER=

# Google Identity Services Web client ID. Use the same public Web client ID in
# the Vercel frontend as VITE_GOOGLE_CLIENT_ID. No Google client secret is
# required for this backend ID-token verification flow.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Mailtrap SMTP. Use the SMTP credentials shown in your Mailtrap inbox.
EMAIL_PROVIDER=mailtrap
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=replace-with-mailtrap-smtp-username
MAILTRAP_SMTP_PASSWORD=replace-with-mailtrap-smtp-password
MAILTRAP_FROM_EMAIL=no-reply@your-storefront-domain.example
EMAIL_TIMEOUT=20

# Optional owner notification recipient for new orders.
ORDER_NOTIFICATION_EMAIL=

# Checkout is temporarily WhatsApp-only. Historical payment records remain
# available in the dashboard; set these flags explicitly to re-enable payment
# methods later.
STRIPE_CHECKOUT_ENABLED=false
WHATSAPP_ONLY_CHECKOUT=true
