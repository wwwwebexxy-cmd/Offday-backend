# Local OFFDAY Collections backend configuration.
# Replace the secret and database fields with values created for this project.
# Set DEBUG=False, a new HTTPS SITE_URL, and production hosts before deployment.
DEBUG=True
SECRET_KEY=replace-with-a-new-long-random-key
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

SITE_URL=http://localhost:5173
STOREFRONT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BRAND_NAME=OFFDAY Collections
BRAND_SHORT_NAME=OFFDAY
BRAND_SUPPORT_EMAIL=
BRAND_PHONE=
BRAND_COUNTRY=
BRAND_TAGLINE=Elevated everyday streetwear
INVOICE_SELLER_NAME=OFFDAY Collections
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_CITY=
INVOICE_SELLER_COUNTRY=
INVOICE_SELLER_VAT_NUMBER=

JWT_ACCESS_COOKIE_NAME=offday_access
JWT_REFRESH_COOKIE_NAME=offday_refresh
JWT_ADMIN_ACCESS_COOKIE_NAME=offday_admin_access
JWT_ADMIN_REFRESH_COOKIE_NAME=offday_admin_refresh

# Local email is printed to the console until a new SMTP service is configured.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=20
ORDER_NOTIFICATION_EMAIL=

GOOGLE_CLIENT_ID=
WHATSAPP_ONLY_CHECKOUT=true
WHATSAPP_OWNER_PHONE=
STRIPE_CHECKOUT_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
